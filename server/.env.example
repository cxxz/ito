PORT=3003
ITO_API_KEY="replace-with-shared-key" # Must match app VITE_GRPC_API_KEY
SECRET_KEY=my-secret
DB_HOST=localhost
DB_PORT=5432
DB_USER=devuser
DB_PASS=devpass
DB_NAME=devdb
DATABASE_URL=postgres://${DB_USER}:${DB_PASS}@${DB_HOST}:5432/${DB_NAME}
IP_SALT=random_value
REQUIRE_AUTH=false
SHOW_CLIENT_LOGS=false
SHOW_ALL_REQUEST_LOGS=false
AUTH0_DOMAIN="auth0_domain"
AUTH0_AUDIENCE="auth0_audience"
AUTH0_CLIENT_ID="auth0_client_id"
AUTH0_CALLBACK_URL=${AUTH0_AUDIENCE}/callback

ALIYUN_API_KEY="your_aliyun_api_key"
GROQ_API_KEY="your_groq_api_key"
CEREBRAS_API_KEY="your_cerebras_api_key"
OPENAI_API_KEY="your_openai_api_key"
# OPENAI_BASE_URL=""  # Optional: defaults to https://api.openai.com/v1

ASR_PROVIDER="groq"  # Options: groq, aliyun, openai
# ALIYUN_DEFAULT_ASR_MODEL=""  # defaults to qwen3-asr-flash
# GROQ_DEFAULT_ASR_MODEL=""  # defaults to whisper-large-v3-turbo
# OPENAI_DEFAULT_ASR_MODEL=""  # defaults to whisper-1

# GROQ_DEFAULT_LLM=""  # defaults to moonshotai/kimi-k2-instruct-0905
# CEREBRAS_DEFAULT_LLM=""  # defaults to qwen-3-235b-a22b-instruct-2507
# OPENAI_DEFAULT_LLM="" # defaults to gpt-5-mini