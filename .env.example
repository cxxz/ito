# Optional defaults. Settings > Server overrides these on this device in both
# development and packaged apps; neither variable is required to open the app.
# Shared endpoint for RPC, HTTP requests, and the server health check.
VITE_ITO_API_BASE_URL="http://localhost:3003"
VITE_ITO_API_KEY="" # Set here or in Settings > Server; must match server ITO_API_KEY

# Keep the environment stable to retain the same app data directory (Ito-<env>).
VITE_ITO_APP_ENV=local # local, dev, or prod
VITE_ITO_APP_VERSION=0.0.1

# Optional development and update settings.
# VITE_ITO_PLATFORM_OVERRIDE="win32" # darwin, win32, or linux
# VITE_ITO_UPDATER_BUCKET="your-release-bucket" # S3 bucket name, not a URL
# VITE_ITO_ENABLE_DEV_UPDATES=false # Enable updates in an unpackaged app
