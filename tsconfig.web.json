{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "app/index.d.ts",
    "app/**/*",
    "server/src/clients/asrCapabilities.ts",
    "lib/**/*",
    "lib/preload/*.d.ts",
    "resources/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "types": ["electron-vite/node"],
    "paths": {
      "@/*": ["./*"]
    }
  }
}
